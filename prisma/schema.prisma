  status      JobStatus @default(PENDING)
  payload     Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model Workflow {
  id          String              @id @default(uuid())
  companyId   String
  name        String
  description String?
  moduleKey   String
  isActive    Boolean             @default(true)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("WorkflowCreator", fields: [createdById], references: [id])
  executions  WorkflowExecution[]
  steps       WorkflowStep[]
  triggers    WorkflowTrigger[]

  @@index([companyId])
  @@index([moduleKey])
}

model WorkflowStep {
  id         String           @id @default(uuid())
  workflowId String
  stepOrder  Int
  type       WorkflowStepType
  config     Json?
  createdAt  DateTime         @default(now())
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowTrigger {
  id         String   @id @default(uuid())
  workflowId String
  eventName  String
  conditions Json?
  createdAt  DateTime @default(now())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowExecution {
  id           String                  @id @default(uuid())
  companyId    String
  workflowId   String
  triggerData  Json?
  status       WorkflowExecutionStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime                @default(now())
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflow     Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model ApprovalFlow {
  id          String            @id @default(uuid())
  companyId   String
  name        String
  description String?
  moduleKey   String
  isActive    Boolean           @default(true)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("ApprovalFlowCreator", fields: [createdById], references: [id])
  requests    ApprovalRequest[]
  steps       ApprovalStep[]

  @@index([companyId])
  @@index([moduleKey])
}

model ApprovalStep {
  id             String       @id @default(uuid())
  companyId      String
  approvalFlowId String
  stepOrder      Int
  approverType   ApproverType
  approverValue  String
  required       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  approvalFlow   ApprovalFlow @relation(fields: [approvalFlowId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id             String            @id @default(uuid())
  companyId      String
  approvalFlowId String
  entityType     String
  entityId       String
  requesterId    String
  currentStep    Int               @default(1)
  status         ApprovalStatus    @default(PENDING)

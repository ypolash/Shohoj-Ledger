generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                   @id @default(uuid())
  name                          String
  email                         String                   @unique
  emailVerified                 Boolean                  @default(false)
  image                         String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  role                          String                   @default("member")
  companyId                     String?
  platformRole                  PlatformRole?
  accounts                      Account[]
  apiKeys                       ApiKey[]                 @relation("ApiKeyCreator")
  approvalFlows                 ApprovalFlow[]           @relation("ApprovalFlowCreator")
  approvalHistories             ApprovalHistory[]
  approvalRequests              ApprovalRequest[]        @relation("ApprovalRequester")
  auditEvents                   AuditEvent[]
  managedBranches               Branch[]                 @relation("BranchManager")
  branchUsers                   BranchUser[]
  businessInsights              BusinessInsight[]
  clientActivities              ClientActivity[]
  clientDocuments               ClientDocument[]
  createdCustomers              Customer[]               @relation("CustomerCreator")
  createdCreditHistories        CustomerCreditHistory[]  @relation("CreditHistoryCreator")
  createdCustomerPayments       CustomerPayment[]        @relation("CustomerPaymentCreator")
  createdCustomerReturns        CustomerReturn[]         @relation("CustomerReturnCreator")
  createdDeliveryOrders         DeliveryOrder[]          @relation("DeliveryOrderCreator")
  globalAuditLogs               GlobalAuditLog[]
  approvedGoodsReceiptNotes     GoodsReceiptNote[]       @relation("GoodsReceiptApprover")
  createdGoodsReceiptNotes      GoodsReceiptNote[]       @relation("GoodsReceiptCreator")
  inventoryAudits               InventoryAudit[]
  createdInventoryTx            InventoryTransaction[]   @relation("InventoryTransactionCreator")
  jobOpenings                   JobOpening[]
  approvedJournalEntries        JournalEntry[]           @relation("JournalEntryApprover")
  createdJournalEntries         JournalEntry[]           @relation("JournalEntryCreator")
  createdLeads                  Lead[]                   @relation("LeadCreator")
  createdLeadActivities         LeadActivity[]           @relation("LeadActivityCreator")
  leadActivities                LeadActivity[]           @relation("PerformedBy")
  ledgerEntries                 LedgerEntry[]
  notifications                 Notification[]
  notificationAudits            NotificationAudit[]
  notificationPreferences       NotificationPreference[]
  notificationQueues            NotificationQueue[]
  createdOpportunities          Opportunity[]            @relation("OpportunityCreator")
  createdOppActivities          OpportunityActivity[]    @relation("OpportunityActivityCreator")
  payrollAudits                 PayrollAudit[]
  projectActivities             ProjectActivity[]
  approvedPurchaseOrders        PurchaseOrder[]          @relation("PurchaseOrderApprover")
  createdPurchaseOrders         PurchaseOrder[]          @relation("PurchaseOrderCreator")
  purchaseRequisitionsApproved  PurchaseRequisition[]    @relation("PurchaseRequisitionApprovedBy")
  purchaseRequisitionsRequested PurchaseRequisition[]    @relation("PurchaseRequisitionRequestedBy")
  createdQuotations             Quotation[]              @relation("QuotationCreator")
  reportAudits                  ReportAudit[]
  reportExecutions              ReportExecution[]        @relation("ReportExecutionRequester")
  createdReportTemplates        ReportTemplate[]         @relation("ReportTemplateCreator")
  createdRfqs                   RequestForQuotation[]    @relation("RfqCreator")
  salesCommissions              SalesCommission[]        @relation("CommissionSalesperson")
  createdSalesOrders            SalesOrder[]             @relation("SalesOrderCreator")
  sessions                      Session[]
  stockTransactions             StockTransaction[]
  createdSuppliers              Supplier[]               @relation("SupplierCreator")
  approvedSupplierInvoices      SupplierInvoice[]        @relation("SupplierInvoiceApprover")
  createdSupplierInvoices       SupplierInvoice[]        @relation("SupplierInvoiceCreator")
  createdSupplierPayments       SupplierPayment[]        @relation("SupplierPaymentCreator")
  approvedVendorComparisons     VendorComparison[]       @relation("VendorComparisonApprover")
  createdVendorComparisons      VendorComparison[]       @relation("VendorComparisonCreator")
  webhooks                      Webhook[]                @relation("WebhookCreator")
  createdWorkflows              Workflow[]               @relation("WorkflowCreator")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Project {
  id              String            @id @default(uuid())
  name            String
  status          String            @default("Draft")
  clientName      String?
  createdAt       DateTime          @default(now())
  companyId       String?
  actualCost      Decimal?          @default(0)
  category        String?
  description     String?
  endDate         DateTime?
  estimatedBudget Decimal?
  leadId          String?
  managerId       String?
  priority        String?           @default("Medium")
  progress        Int?              @default(0)
  projectCode     String?
  startDate       DateTime?
  tags            String[]
  updatedAt       DateTime          @updatedAt
  systemSource    String            @default("LEGACY")
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id])
  company         Company?          @relation(fields: [companyId], references: [id])
  lead            Lead?             @relation(fields: [leadId], references: [id])
  manager         Employee?         @relation("ProjectManager", fields: [managerId], references: [id])
  activities      ProjectActivity[]
  tasks           Task[]
  teamMembers     Employee[]        @relation("ProjectTeam")

  @@unique([companyId, projectCode])
  @@index([companyId])
}

model Income {
  id            String   @id @default(uuid())
  projectId     String?
  category      String
  source        String?
  amount        Decimal
  received      Decimal  @default(0)
  paymentStatus String
  shareable     Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  companyId     String?
  attachments   String[] @default([])
  company       Company? @relation(fields: [companyId], references: [id])
  systemSource  String   @default("LEGACY")

  @@index([companyId])
}

model Expense {
  id             String   @id @default(uuid())
  projectId      String?
  category       String
  amount         Decimal
  paymentMethod  String
  approvalStatus String
  description    String?
  createdAt      DateTime @default(now())
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  systemSource   String   @default("LEGACY")

  @@index([companyId])
}

model FundTransaction {
  id           String   @id @default(uuid())
  amount       Decimal
  source       String?
  description  String?
  createdAt    DateTime @default(now())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  systemSource String   @default("LEGACY")

  @@index([companyId])
}

model ReserveTransaction {
  id           String   @id @default(uuid())
  type         String
  amount       Decimal
  reason       String?
  createdAt    DateTime @default(now())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  systemSource String   @default("LEGACY")

  @@index([companyId])
}

model MemberLoan {
  id              String   @id @default(uuid())
  memberId        String
  amount          Decimal
  remainingAmount Decimal
  issueDate       DateTime @default(now())
  dueDate         DateTime
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  reason          String?
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  systemSource    String   @default("LEGACY")

  @@index([companyId])
}

model Advance {
  id              String   @id @default(uuid())
  memberId        String
  amount          Decimal
  remainingAmount Decimal
  reason          String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  systemSource    String   @default("LEGACY")

  @@index([companyId])
}

model Settlement {
  id             String   @id @default(uuid())
  period         String
  status         String   @default("PENDING")
  totalIncome    Decimal
  totalExpenses  Decimal
  ceoShare       Decimal
  developerShare Decimal
  companyShare   Decimal
  createdAt      DateTime @default(now())
  advisorShare   Decimal
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  systemSource   String   @default("LEGACY")

  @@index([companyId])
}

model IncomeCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  createdAt    DateTime @default(now())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  systemSource String   @default("LEGACY")

  @@index([companyId])
}

model Member {
  id        String   @id @default(uuid())
  name      String
  role      String
  email     String?  @unique
  phone     String?
  status    String   @default("ACTIVE")
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Employee {
  id                           String                        @id @default(uuid())
  userId                       String?                       @unique
  employeeId                   String                        @unique
  password                     String?
  firstName                    String
  lastName                     String
  email                        String                        @unique
  phone                        String?
  designation                  String
  department                   String?
  joinDate                     DateTime
  basicSalary                  Decimal
  status                       String                        @default("ACTIVE")
  systemSource                 String                        @default("LEGACY")
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  companyId                    String?
  departmentId                 String?
  designationId                String?
  employmentStatus             String?                       @default("Probation")
  employmentType               String?
  location                     String?
  reportingManagerId           String?
  shift                        String?
  branchId                     String?
  costCenterId                 String?
  divisionId                   String?
  employeeGradeId              String?
  jobPositionId                String?
  sectionId                    String?
  teamId                       String?
  workShiftId                  String?
  assignedAssets               Asset[]                       @relation("EmployeeAssets")
  attendances                  Attendance[]
  adjustments                  AttendanceAdjustment[]
  exceptions                   AttendanceException[]
  holidayAssignments           AttendanceHolidayAssignment[]
  overtimes                    AttendanceOvertime[]
  rosters                      AttendanceRoster[]
  shiftAssignments             AttendanceShiftAssignment[]
  barcodes                     Barcode[]
  bonuses                      Bonus[]
  cycleCountsApproved          CycleCount[]                  @relation("CycleCountApprovedBy")
  cycleCountsCreated           CycleCount[]                  @relation("CycleCountCreatedBy")
  headOfDepartment             Department[]                  @relation("DepartmentHead")
  headOfDivision               Division[]                    @relation("DivisionHead")
  branch                       Branch?                       @relation(fields: [branchId], references: [id])
  company                      Company?                      @relation(fields: [companyId], references: [id])
  costCenter                   CostCenter?                   @relation(fields: [costCenterId], references: [id])
  departmentRef                Department?                   @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  designationRef               Designation?                  @relation("EmployeeDesignation", fields: [designationId], references: [id])
  division                     Division?                     @relation(fields: [divisionId], references: [id])
  employeeGrade                EmployeeGrade?                @relation(fields: [employeeGradeId], references: [id])
  jobPosition                  JobPosition?                  @relation(fields: [jobPositionId], references: [id])
  reportingManager             Employee?                     @relation("EmployeeToManager", fields: [reportingManagerId], references: [id])
  subordinates                 Employee[]                    @relation("EmployeeToManager")
  section                      Section?                      @relation(fields: [sectionId], references: [id])
  team                         Team?                         @relation(fields: [teamId], references: [id])
  workShift                    WorkShift?                    @relation(fields: [workShiftId], references: [id])
  addresses                    EmployeeAddress[]
  documents                    EmployeeDocument[]
  education                    EmployeeEducation[]
  emergencyContacts            EmployeeEmergencyContact[]
  experience                   EmployeeExperience[]
  lifecycleEvents              EmployeeLifecycle[]
  loansApproved                EmployeeLoan[]                @relation("LoanApprover")
  loans                        EmployeeLoan[]
  profile                      EmployeeProfile?
  reporting                    EmployeeReporting[]           @relation("EmployeeToReporting")
  managedReporting             EmployeeReporting[]           @relation("ManagerToReporting")
  salaryHistories              EmployeeSalary[]
  interviewsConducted          Interview[]
  interviewFeedbacks           InterviewFeedback[]
  inventoryAdjustmentsApproved InventoryAdjustment[]         @relation("AdjustmentApprovedBy")
  inventoryAdjustmentsCreated  InventoryAdjustment[]         @relation("AdjustmentCreatedBy")
  leads                        Lead[]
  leaveAccruals                LeaveAccrual[]
  leaveApprovals               LeaveApproval[]
  leaveBalances                LeaveBalance[]
  leaveEncashments             LeaveEncashment[]
  leaveRequests                LeaveRequest[]
  ownedOpportunities           Opportunity[]                 @relation("OpportunityOwner")
  packingTasksPacked           PackingTask[]                 @relation("PackingTaskPackedBy")
  payrollApprovals             PayrollApproval[]
  payrollItems                 PayrollItem[]
  payrollRunsProcessed         PayrollRun[]
  payslips                     Payslip[]
  performanceFeedbacksGiven    PerformanceFeedback[]         @relation("FeedbackAuthor")
  performanceGoals             PerformanceGoal[]
  performancePIPs              PerformanceImprovementPlan[]
  performanceReviews           PerformanceReview[]
  performanceReviewsGiven      PerformanceReview[]           @relation("Reviewer")
  pickingTasksAssigned         PickingTask[]                 @relation("PickingTaskAssignedTo")
  managedProjects              Project[]                     @relation("ProjectManager")
  putAwayTasks                 PutAwayTask[]
  salaryAdvances               SalaryAdvance[]
  deductions                   SalaryDeduction[]
  salaryPayments               SalaryPayment[]
  headOfSection                Section[]                     @relation("SectionHead")
  stockMovements               StockMovement[]
  transfersApproved            StockTransfer[]               @relation("TransferApprovedBy")
  transfersRequested           StockTransfer[]               @relation("TransferRequestedBy")
  tasks                        Task[]
  leadOfTeam                   Team[]                        @relation("TeamLead")
  trainingAssessmentsDone      TrainingAssessment[]          @relation("Assessor")
  trainingEnrollments          TrainingEnrollment[]          @relation("Trainee")
  trainingSessionsLed          TrainingSession[]             @relation("Trainer")
  managedWarehouses            Warehouse[]                   @relation("WarehouseManager")
  teamProjects                 Project[]                     @relation("ProjectTeam")
  employeeFines                EmployeeFine[]

  @@index([companyId])
}

model Task {
  id                   String                 @id @default(uuid())
  assignedToEmployeeId String?
  title                String
  description          String?
  priority             String?                @default("Medium")
  status               String                 @default("To Do")
  dueDate              DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  systemSource         String                 @default("LEGACY")
  companyId            String?
  actualHours          Decimal?               @default(0)
  attachments          Json?
  checklist            Json?
  estimatedHours       Decimal?               @default(0)
  projectId            String?
  adjustments          AttendanceAdjustment[]
  exceptions           AttendanceException[]
  overtimes            AttendanceOvertime[]
  employee             Employee?              @relation(fields: [assignedToEmployeeId], references: [employeeId])
  company              Company?               @relation(fields: [companyId], references: [id])
  project              Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
}

model Attendance {
  id                    String                 @id @default(uuid())
  employeeId            String
  date                  DateTime
  checkInTime           DateTime?              @map("checkIn")
  checkInLocation       String?
  checkOutTime          DateTime?              @map("checkOut")
  checkOutLocation      String?
  status                String
  lateMinutes           Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  systemSource          String                 @default("LEGACY")
  isLate                Boolean                @default(false)
  latitude              Float?
  longitude             Float?
  totalWorkingMinutes   Int?                   @default(0)
  wifiBssid             String?
  wifiSsid              String?
  earlyLeaveMinutes     Int?                   @default(0)
  overtimeMinutes       Int?                   @default(0)
  punishmentAmount      Decimal?               @default(0)
  punishmentReason      String?
  reviewStatus          String?
  companyId             String?
  company               Company?               @relation(fields: [companyId], references: [id])
  employee              Employee               @relation(fields: [employeeId], references: [id])
  attendanceAdjustments AttendanceAdjustment[]
  attendanceExceptions  AttendanceException[]
  attendanceOvertimes   AttendanceOvertime[]

  @@unique([employeeId, date])
  @@index([companyId])
}

model AttendanceShiftAssignment {
  id            String    @id @default(uuid())
  employeeId    String
  workShiftId   String
  effectiveDate DateTime
  endDate       DateTime?
  isRotation    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workShift     WorkShift @relation(fields: [workShiftId], references: [id])

  @@index([employeeId])
}

model AttendanceException {
  id              String     @id @default(uuid())
  attendanceId    String
  employeeId      String
  type            String
  durationMinutes Int        @default(0)
  reason          String?
  status          String     @default("PENDING")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  taskId          String?
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task            Task?      @relation(fields: [taskId], references: [id])

  @@index([attendanceId])
  @@index([employeeId])
}

model AttendanceAdjustment {
  id            String     @id @default(uuid())
  attendanceId  String
  employeeId    String
  type          String
  reason        String?
  requestedById String?
  approvedById  String?
  status        String     @default("PENDING")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  taskId        String?
  attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task          Task?      @relation(fields: [taskId], references: [id])

  @@index([attendanceId])
  @@index([employeeId])
}

model AttendanceOvertime {
  id           String     @id @default(uuid())
  attendanceId String
  employeeId   String
  type         String
  hours        Decimal    @default(0)
  rate         Decimal    @default(1.0)
  status       String     @default("PENDING")
  approvedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  taskId       String?
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task         Task?      @relation(fields: [taskId], references: [id])

  @@index([attendanceId])
  @@index([employeeId])
}

model AttendanceRoster {
  id          String    @id @default(uuid())
  companyId   String
  employeeId  String
  workShiftId String
  date        DateTime
  status      String    @default("PLANNED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workShift   WorkShift @relation(fields: [workShiftId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

model AttendanceHolidayAssignment {
  id         String          @id @default(uuid())
  companyId  String
  employeeId String
  holidayId  String
  date       DateTime
  status     String          @default("ACTIVE")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  holiday    HolidayCalendar @relation(fields: [holidayId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

model JobOpening {
  id               String          @id @default(uuid())
  companyId        String
  jobCode          String?
  title            String
  departmentId     String?
  designationId    String?
  employmentTypeId String?
  vacancies        Int             @default(1)
  openingDate      DateTime
  closingDate      DateTime?
  status           String          @default("OPEN")
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  applications     Application[]
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [createdById], references: [id])
  department       Department?     @relation(fields: [departmentId], references: [id])
  designation      Designation?    @relation(fields: [designationId], references: [id])
  employmentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id])

  @@index([companyId])
}

model Applicant {
  id           String        @id @default(uuid())
  companyId    String
  fullName     String
  email        String
  phone        String?
  dateOfBirth  DateTime?
  resume       String?
  linkedin     String?
  portfolio    String?
  status       String        @default("NEW")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([companyId, email])
  @@index([companyId])
}

model Application {
  id           String      @id @default(uuid())
  jobOpeningId String
  applicantId  String
  currentStage String      @default("APPLIED")
  source       String?
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  applicant    Applicant   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobOpening   JobOpening  @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  interviews   Interview[]
  jobOffers    JobOffer[]

  @@unique([jobOpeningId, applicantId])
  @@index([jobOpeningId])
  @@index([applicantId])
}

model Interview {
  id            String              @id @default(uuid())
  applicationId String
  type          String
  date          DateTime
  interviewerId String
  location      String?
  onlineLink    String?
  status        String              @default("SCHEDULED")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer   Employee            @relation(fields: [interviewerId], references: [id])
  feedbacks     InterviewFeedback[]

  @@index([applicationId])
  @@index([interviewerId])
}

model InterviewFeedback {
  id                 String    @id @default(uuid())
  interviewId        String
  interviewerId      String
  technicalScore     Int?
  communicationScore Int?
  cultureScore       Int?
  overallScore       Int?
  recommendation     String?
  comments           String?
  createdAt          DateTime  @default(now())
  interview          Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer        Employee  @relation(fields: [interviewerId], references: [id])

  @@index([interviewId])
  @@index([interviewerId])
}

model JobOffer {
  id             String       @id @default(uuid())
  applicationId  String
  salary         Decimal
  joiningDate    DateTime
  designationId  String?
  departmentId   String?
  status         String       @default("PENDING")
  offerLetterUrl String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id])
  designation    Designation? @relation(fields: [designationId], references: [id])

  @@index([applicationId])
}

model LeaveRequest {
  id            String          @id @default(uuid())
  employeeId    String
  type          String
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        String          @default("PENDING")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  systemSource  String          @default("LEGACY")
  companyId     String?
  approvedById  String?
  attachmentUrl String?
  comments      String?
  isHalfDay     Boolean         @default(false)
  leaveTypeId   String?
  approvals     LeaveApproval[]
  company       Company?        @relation(fields: [companyId], references: [id])
  employee      Employee        @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType?      @relation(fields: [leaveTypeId], references: [id])

  @@index([companyId])
}

model SalaryPayment {
  id             String         @id @default(uuid())
  employeeId     String
  month          Int
  year           Int
  basicSalary    Decimal
  grossSalary    Decimal
  netSalary      Decimal
  paymentDate    DateTime?
  status         String         @default("PAID")
  expenseId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  companyId      String?
  paymentMethod  String?
  paymentNote    String?
  transactionRef String?
  audits         PayrollAudit[]
  company        Company?       @relation(fields: [companyId], references: [id])
  employee       Employee       @relation(fields: [employeeId], references: [id])

  @@index([companyId])
}

model SalaryDeduction {
  id         String   @id @default(uuid())
  employeeId String
  month      Int
  year       Int
  type       String
  amount     Decimal
  reason     String?
  createdAt  DateTime @default(now())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId])
}

model Bonus {
  id         String   @id @default(uuid())
  employeeId String
  month      Int
  year       Int
  type       String
  amount     Decimal
  reason     String?
  expenseId  String?
  createdAt  DateTime @default(now())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId])
}

model Payslip {
  id              String   @id @default(uuid())
  employeeId      String
  month           Int
  year            Int
  fileUrl         String?
  totalEarnings   Decimal
  totalDeductions Decimal
  netPay          Decimal
  createdAt       DateTime @default(now())
  systemSource    String   @default("LEGACY")
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  employee        Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@index([companyId])
}

model LeadSource {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model Lead {
  id                  String         @id @default(uuid())
  serialNumber        Int            @default(autoincrement())
  companyName         String
  contactPerson       String
  phone               String
  email               String?
  serviceType         String?
  expectedValue       Decimal?
  leadSource          String?
  nextFollowUp        DateTime?
  notes               String?
  status              String         @default("New")
  lostReason          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  systemSource        String         @default("LEGACY")
  companyId           String?
  address             String?
  assignedToId        String?
  expectedClosingDate DateTime?
  industry            String?
  priority            String         @default("Medium")
  tags                String[]
  website             String?
  clientId            String?
  contactName         String?
  createdById         String?
  customerId          String?
  estimatedValue      Decimal?
  expectedCloseDate   DateTime?
  leadNumber          String         @unique @default(cuid())
  leadPriority        LeadPriority   @default(MEDIUM)
  leadSourceId        String?
  leadStatus          LeadStatus     @default(NEW)
  mobile              String?
  rating              LeadRating?
  assignedTo          Employee?      @relation(fields: [assignedToId], references: [id])
  client              Client?        @relation(fields: [clientId], references: [id])
  company             Company?       @relation(fields: [companyId], references: [id])
  createdBy           User?          @relation("LeadCreator", fields: [createdById], references: [id])
  customer            Customer?      @relation(fields: [customerId], references: [id])
  leadSourceModel     LeadSource?    @relation(fields: [leadSourceId], references: [id])
  activities          LeadActivity[]
  opportunities       Opportunity[]
  projects            Project[]

  @@index([status])
  @@index([leadStatus])
  @@index([priority])
  @@index([rating])
  @@index([assignedToId])
  @@index([companyId])
  @@index([customerId])
  @@index([leadSourceId])
}

model LeadActivity {
  id            String   @id @default(uuid())
  companyId     String?
  leadId        String
  type          String?
  description   String?
  oldValue      String?
  newValue      String?
  performedById String?
  createdAt     DateTime @default(now())
  activityDate  DateTime @default(now())
  activityType  String?
  createdById   String?
  subject       String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation("LeadActivityCreator", fields: [createdById], references: [id])
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy   User?    @relation("PerformedBy", fields: [performedById], references: [id])

  @@index([leadId])
  @@index([companyId])
}

model OpportunityPipeline {
  id            String             @id @default(uuid())
  companyId     String
  name          String
  description   String?
  isDefault     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  opportunities Opportunity[]
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages        OpportunityStage[]

  @@unique([companyId, name])
  @@index([companyId])
}

model OpportunityStage {
  id             String               @id @default(uuid())
  companyId      String
  name           String
  displayOrder   Int                  @default(0)
  winProbability Int                  @default(0)
  isClosed       Boolean              @default(false)
  isWon          Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  pipelineId     String?
  opportunities  Opportunity[]
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline       OpportunityPipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([pipelineId])
}

model Opportunity {
  id                String                @id @default(uuid())
  companyId         String
  opportunityNumber String                @unique @default(cuid())
  customerId        String
  leadId            String?
  stageId           String
  ownerId           String?
  title             String
  description       String?
  estimatedRevenue  Decimal               @default(0)
  expectedCloseDate DateTime?
  probability       Int                   @default(0)
  status            OpportunityStatus     @default(OPEN)
  priority          String                @default("Medium")
  source            String?
  currency          String                @default("BDT")
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lostReason        String?
  pipelineId        String?
  tags              String[]              @default([])
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy         User                  @relation("OpportunityCreator", fields: [createdById], references: [id])
  customer          Customer              @relation(fields: [customerId], references: [id])
  lead              Lead?                 @relation(fields: [leadId], references: [id])
  owner             Employee?             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  pipeline          OpportunityPipeline?  @relation(fields: [pipelineId], references: [id])
  stage             OpportunityStage      @relation(fields: [stageId], references: [id])
  activities        OpportunityActivity[]
  quotations        Quotation[]

  @@index([companyId])
  @@index([customerId])
  @@index([pipelineId])
  @@index([leadId])
  @@index([stageId])
  @@index([ownerId])
  @@index([status])
}

model OpportunityActivity {
  id            String      @id @default(uuid())
  opportunityId String
  activityType  String
  activityDate  DateTime    @default(now())
  subject       String
  description   String?
  createdById   String
  createdAt     DateTime    @default(now())
  createdBy     User        @relation("OpportunityActivityCreator", fields: [createdById], references: [id])
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model Quotation {
  id              String          @id @default(uuid())
  companyId       String
  quotationNumber String          @unique @default(cuid())
  customerId      String
  opportunityId   String?
  status          QuotationStatus @default(DRAFT)
  quotationDate   DateTime        @default(now())
  expiryDate      DateTime
  currency        String          @default("BDT")
  priceLevel      String?
  subtotal        Decimal         @default(0)
  discountAmount  Decimal         @default(0)
  taxAmount       Decimal         @default(0)
  shippingAmount  Decimal         @default(0)
  totalAmount     Decimal         @default(0)
  remarks         String?
  approvedById    String?
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("QuotationCreator", fields: [createdById], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  opportunity     Opportunity?    @relation(fields: [opportunityId], references: [id])
  lines           QuotationLine[]
  salesOrders     SalesOrder[]

  @@index([companyId])
  @@index([customerId])
  @@index([opportunityId])
  @@index([status])
}

model QuotationLine {
  id              String     @id @default(uuid())
  quotationId     String
  productId       String
  description     String?
  quantity        Decimal
  unitPrice       Decimal
  discountPercent Decimal    @default(0)
  discountAmount  Decimal    @default(0)
  taxPercent      Decimal    @default(0)
  taxAmount       Decimal    @default(0)
  lineTotal       Decimal
  warehouseId     String?
  remarks         String?
  taxRate         Decimal?   @default(0)
  systemSource    String     @default("LEGACY")
  product         Product    @relation(fields: [productId], references: [id])
  quotation       Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  warehouse       Warehouse? @relation("QuotationLineWarehouse", fields: [warehouseId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@index([warehouseId])
}

model SalesOrder {
  id                    String            @id @default(uuid())
  companyId             String
  salesOrderNumber      String            @unique @default(cuid())
  quotationId           String?
  customerId            String
  status                SalesOrderStatus  @default(DRAFT)
  orderDate             DateTime          @default(now())
  requestedDeliveryDate DateTime?
  currency              String            @default("BDT")
  subtotal              Decimal           @default(0)
  discountAmount        Decimal           @default(0)
  taxAmount             Decimal           @default(0)
  shippingAmount        Decimal           @default(0)
  totalAmount           Decimal           @default(0)
  remarks               String?
  approvedById          String?
  approvedAt            DateTime?
  createdById           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deliveryOrders        DeliveryOrder[]
  salesCommissions      SalesCommission[]
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy             User              @relation("SalesOrderCreator", fields: [createdById], references: [id])
  customer              Customer          @relation(fields: [customerId], references: [id])
  quotation             Quotation?        @relation(fields: [quotationId], references: [id])
  lines                 SalesOrderLine[]

  @@index([companyId])
  @@index([customerId])
  @@index([quotationId])
  @@index([status])
}

model SalesOrderLine {
  id               String              @id @default(uuid())
  salesOrderId     String
  productId        String
  warehouseId      String
  quantity         Decimal
  reservedQuantity Decimal             @default(0)
  unitPrice        Decimal
  discountPercent  Decimal             @default(0)
  discountAmount   Decimal             @default(0)
  taxPercent       Decimal             @default(0)
  taxAmount        Decimal             @default(0)
  lineTotal        Decimal
  remarks          String?
  deliveryLines    DeliveryOrderLine[]
  product          Product             @relation(fields: [productId], references: [id])
  salesOrder       SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  warehouse        Warehouse           @relation("SalesOrderLineWarehouse", fields: [warehouseId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
  @@index([warehouseId])
}

model DeliveryOrder {
  id              String              @id @default(uuid())
  companyId       String
  deliveryNumber  String              @unique @default(cuid())
  salesOrderId    String
  customerId      String
  warehouseId     String
  status          DeliveryOrderStatus @default(DRAFT)
  deliveryDate    DateTime            @default(now())
  carrier         String?
  trackingNumber  String?
  remarks         String?
  approvedById    String?
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  customerReturns CustomerReturn[]
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("DeliveryOrderCreator", fields: [createdById], references: [id])
  customer        Customer            @relation(fields: [customerId], references: [id])
  salesOrder      SalesOrder          @relation(fields: [salesOrderId], references: [id])
  warehouse       Warehouse           @relation("DeliveryOrderWarehouse", fields: [warehouseId], references: [id])
  lines           DeliveryOrderLine[]

  @@index([companyId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([warehouseId])
  @@index([status])
}

model DeliveryOrderLine {
  id                  String               @id @default(uuid())
  deliveryOrderId     String
  salesOrderLineId    String
  productId           String
  batchId             String?
  serialId            String?
  quantity            Decimal
  warehouseId         String
  zoneId              String?
  binId               String?
  remarks             String?
  customerReturnLines CustomerReturnLine[]
  batch               InventoryBatch?      @relation("DeliveryLineBatch", fields: [batchId], references: [id])
  bin                 WarehouseBin?        @relation("DeliveryLineBin", fields: [binId], references: [id])
  deliveryOrder       DeliveryOrder        @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])
  salesOrderLine      SalesOrderLine       @relation(fields: [salesOrderLineId], references: [id])
  serial              InventorySerial?     @relation("DeliveryLineSerial", fields: [serialId], references: [id])
  warehouse           Warehouse            @relation("DeliveryOrderLineWarehouse", fields: [warehouseId], references: [id])
  zone                WarehouseZone?       @relation("DeliveryLineZone", fields: [zoneId], references: [id])

  @@index([deliveryOrderId])
  @@index([salesOrderLineId])
  @@index([productId])
  @@index([warehouseId])
}

model CustomerReturn {
  id               String               @id @default(uuid())
  companyId        String
  returnNumber     String               @unique @default(cuid())
  deliveryOrderId  String
  customerId       String
  warehouseId      String
  status           CustomerReturnStatus @default(DRAFT)
  returnDate       DateTime             @default(now())
  reason           String?
  inspectionStatus String?
  remarks          String?
  approvedById     String?
  approvedAt       DateTime?
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("CustomerReturnCreator", fields: [createdById], references: [id])
  customer         Customer             @relation(fields: [customerId], references: [id])
  deliveryOrder    DeliveryOrder        @relation(fields: [deliveryOrderId], references: [id])
  warehouse        Warehouse            @relation("CustomerReturnWarehouse", fields: [warehouseId], references: [id])
  lines            CustomerReturnLine[]

  @@index([companyId])
  @@index([customerId])
  @@index([deliveryOrderId])
  @@index([warehouseId])
  @@index([status])
}

model CustomerReturnLine {
  id                  String            @id @default(uuid())
  customerReturnId    String
  deliveryOrderLineId String
  productId           String
  batchId             String?
  serialId            String?
  quantity            Decimal
  returnCondition     ReturnCondition   @default(GOOD)
  warehouseId         String
  zoneId              String?
  binId               String?
  remarks             String?
  batch               InventoryBatch?   @relation("CustomerReturnLineBatch", fields: [batchId], references: [id])
  bin                 WarehouseBin?     @relation("CustomerReturnLineBin", fields: [binId], references: [id])
  customerReturn      CustomerReturn    @relation(fields: [customerReturnId], references: [id], onDelete: Cascade)
  deliveryOrderLine   DeliveryOrderLine @relation(fields: [deliveryOrderLineId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])
  serial              InventorySerial?  @relation("CustomerReturnLineSerial", fields: [serialId], references: [id])
  warehouse           Warehouse         @relation("CustomerReturnLineWarehouse", fields: [warehouseId], references: [id])
  zone                WarehouseZone?    @relation("CustomerReturnLineZone", fields: [zoneId], references: [id])

  @@index([customerReturnId])
  @@index([deliveryOrderLineId])
  @@index([productId])
  @@index([warehouseId])
}

model CustomerCreditProfile {
  id              String    @id @default(uuid())
  companyId       String
  customerId      String    @unique
  creditLimit     Decimal   @default(0)
  creditDays      Int       @default(0)
  currentExposure Decimal   @default(0)
  availableCredit Decimal   @default(0)
  riskLevel       RiskLevel @default(LOW)
  isOnHold        Boolean   @default(false)
  holdReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([riskLevel])
  @@index([isOnHold])
}

model CustomerCreditHistory {
  id               String   @id @default(uuid())
  companyId        String
  customerId       String
  referenceType    String
  referenceId      String?
  previousExposure Decimal
  newExposure      Decimal
  remarks          String?
  createdById      String
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        User     @relation("CreditHistoryCreator", fields: [createdById], references: [id])
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([referenceType])
}

model CustomerPayment {
  id                String                      @id @default(uuid())
  companyId         String
  paymentNumber     String                      @unique @default(cuid())
  customerId        String
  paymentDate       DateTime                    @default(now())
  paymentMethod     PaymentMethod
  referenceNumber   String?
  bankAccountId     String?
  currency          String                      @default("USD")
  amount            Decimal                     @default(0)
  allocatedAmount   Decimal                     @default(0)
  unallocatedAmount Decimal                     @default(0)
  status            CustomerPaymentStatus       @default(DRAFT)
  remarks           String?
  createdById       String
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy         User                        @relation("CustomerPaymentCreator", fields: [createdById], references: [id])
  customer          Customer                    @relation(fields: [customerId], references: [id])
  allocations       CustomerPaymentAllocation[]
  salesCommissions  SalesCommission[]

  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

model CustomerPaymentAllocation {
  id                String          @id @default(uuid())
  customerPaymentId String
  referenceType     String
  referenceId       String
  allocatedAmount   Decimal
  createdAt         DateTime        @default(now())
  customerPayment   CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)

  @@index([customerPaymentId])
  @@index([referenceType, referenceId])
}

model CommissionPolicy {
  id                String            @id @default(uuid())
  companyId         String
  name              String
  description       String?
  calculationType   CalculationType
  commissionRate    Decimal           @default(0)
  minimumTarget     Decimal?
  maximumCommission Decimal?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commissions       SalesCommission[]

  @@index([companyId])
}

model SalesCommission {
  id                 String           @id @default(uuid())
  companyId          String
  salespersonId      String
  customerId         String
  salesOrderId       String?
  paymentId          String?
  commissionPolicyId String
  baseAmount         Decimal
  commissionAmount   Decimal
  status             CommissionStatus @default(PENDING)
  calculatedAt       DateTime?
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  policy             CommissionPolicy @relation(fields: [commissionPolicyId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer         @relation(fields: [customerId], references: [id])
  payment            CustomerPayment? @relation(fields: [paymentId], references: [id])
  salesOrder         SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  salesperson        User             @relation("CommissionSalesperson", fields: [salespersonId], references: [id])

  @@index([companyId])
  @@index([salespersonId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([paymentId])
  @@index([status])
}

model AllowedNetwork {
  id        String   @id @default(cuid())
  name      String
  ssid      String
  bssid     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model PunishmentSetting {
  id          String   @id @default(uuid())
  type        String
  fromMinutes Int
  toMinutes   Int
  amount      Decimal
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model AttendanceConfig {
  id                        String   @id @default(uuid())
  gracePeriod               Int      @default(15)
  shiftStart                String   @default("09:00")
  shiftEnd                  String   @default("20:00")
  fridayOff                 Boolean  @default(true)
  enablePunishmentDeduction Boolean  @default(false)
  companyId                 String?
  company                   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Company {
  id                       String                        @id @default(uuid())
  name                     String
  businessType             String
  status                   String                        @default("ACTIVE")
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  subscription             Subscription?
  saasInvoices             SaaSInvoice[]
  accountingPeriods        AccountingPeriod[]
  advances                 Advance[]
  allowedNetworks          AllowedNetwork[]
  analyticsSnapshots       AnalyticsSnapshot[]
  announcements            Announcement[]
  apiKeys                  ApiKey[]
  applicants               Applicant[]
  approvalFlows            ApprovalFlow[]
  approvalHistories        ApprovalHistory[]
  approvalRequests         ApprovalRequest[]
  approvalSteps            ApprovalStep[]
  assets                   Asset[]
  assetCategories          AssetCategory[]
  attendances              Attendance[]
  attendanceConfigs        AttendanceConfig[]
  holidayAssignments       AttendanceHolidayAssignment[]
  attendanceRosters        AttendanceRoster[]
  auditEvents              AuditEvent[]
  backgroundJobs           BackgroundJob[]
  barcodes                 Barcode[]
  bonuses                  Bonus[]
  branches                 Branch[]
  businessInsights         BusinessInsight[]
  chartOfAccounts          ChartOfAccount[]
  clients                  Client[]
  commissionPolicies       CommissionPolicy[]
  modules                  CompanyModule[]
  settings                 CompanySetting?
  costCenters              CostCenter[]
  customers                Customer[]
  customerAddresses        CustomerAddress[]
  customerContacts         CustomerContact[]
  creditHistories          CustomerCreditHistory[]
  creditProfiles           CustomerCreditProfile[]
  customerDocuments        CustomerDocument[]
  customerGroups           CustomerGroup[]
  customerPayments         CustomerPayment[]
  customerReturns          CustomerReturn[]
  cycleCounts              CycleCount[]
  deliveryOrders           DeliveryOrder[]
  departments              Department[]
  designations             Designation[]
  divisions                Division[]
  employees                Employee[]
  employeeGrades           EmployeeGrade[]
  lifecycles               EmployeeLifecycle[]
  employeeLoans            EmployeeLoan[]
  employmentTypes          EmploymentType[]
  expenses                 Expense[]
  fiscalYears              FiscalYear[]
  forecastRecords          ForecastRecord[]
  fundTransactions         FundTransaction[]
  globalAuditLogs          GlobalAuditLog[]
  goodsReceiptNotes        GoodsReceiptNote[]
  holidayCalendars         HolidayCalendar[]
  incomes                  Income[]
  incomeCategories         IncomeCategory[]
  inventoryAdjustments     InventoryAdjustment[]
  inventoryAudits          InventoryAudit[]
  inventoryBatches         InventoryBatch[]
  inventorySerials         InventorySerial[]
  inventoryTransactions    InventoryTransaction[]
  inventoryValuationLayers InventoryValuationLayer[]
  jobOpenings              JobOpening[]
  jobPositions             JobPosition[]
  journals                 Journal[]
  journalEntries           JournalEntry[]
  leads                    Lead[]
  leadActivities           LeadActivity[]
  leadSources              LeadSource[]
  leaveRequests            LeaveRequest[]
  leaveTypes               LeaveType[]
  ledgerEntries            LedgerEntry[]
  members                  Member[]
  memberLoans              MemberLoan[]
  notifications            Notification[]
  notificationAudits       NotificationAudit[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  notificationPreferences  NotificationPreference[]
  notificationQueues       NotificationQueue[]
  notificationTemplates    NotificationTemplate[]
  opportunities            Opportunity[]
  opportunityPipelines     OpportunityPipeline[]
  opportunityStages        OpportunityStage[]
  packingTasks             PackingTask[]
  payrollAudits            PayrollAudit[]
  payrollPeriods           PayrollPeriod[]
  payrollRuns              PayrollRun[]
  payslips                 Payslip[]
  performanceCycles        PerformanceCycle[]
  pickingTasks             PickingTask[]
  products                 Product[]
  productCategories        ProductCategory[]
  productWarehouses        ProductWarehouse[]
  projects                 Project[]
  projectActivities        ProjectActivity[]
  punishmentSettings       PunishmentSetting[]
  purchaseOrders           PurchaseOrder[]

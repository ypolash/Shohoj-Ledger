  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  report     ReportTemplate @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([nextRunAt])
}

model ApiKey {

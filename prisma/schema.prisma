  zipCode     String?
  country     String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierBankAccount {
  id            String   @id @default(uuid())
  supplierId    String
  bankName      String
  accountName   String
  accountNumber String
  routingNumber String?
  swiftCode     String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierDocument {
  id         String   @id @default(uuid())
  supplierId String
  title      String
  fileUrl    String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierCommunicationLog {
  id         String   @id @default(uuid())
  supplierId String
  type       String
  notes      String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  companyId            String
  supplierId           String
  orderDate            DateTime            @default(now())
  totalAmount          Decimal             @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  approvedAt           DateTime?
  approvedById         String?
  createdById          String?
  currency             String              @default("USD")
  discountAmount       Decimal             @default(0)
  expectedDeliveryDate DateTime?
  paymentTerms         String?
  purchaseOrderNumber  String
  remarks              String?
  shippingAmount       Decimal             @default(0)
  subtotal             Decimal             @default(0)
  taxAmount            Decimal             @default(0)
  vendorComparisonId   String?
  warehouseId          String?
  status               PurchaseOrderStatus @default(DRAFT)
  goodsReceiptNotes    GoodsReceiptNote[]
  approvedBy           User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy            User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  warehouse            Warehouse?          @relation(fields: [warehouseId], references: [id])
  lines                PurchaseOrderLine[]
  stockTransactions    StockTransaction[]
  supplierInvoices     SupplierInvoice[]
  threeWayMatches      ThreeWayMatch[]
  systemSource         String              @default("LEGACY")

  @@unique([companyId, purchaseOrderNumber])
  @@index([companyId])
  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id                   String                @id @default(uuid())
  purchaseOrderId      String
  productId            String?
  warehouseId          String?
  quantity             Decimal
  receivedQuantity     Decimal               @default(0)
  unitPrice            Decimal
  discountPercent      Decimal               @default(0)
  discountAmount       Decimal               @default(0)
  taxPercent           Decimal               @default(0)
  taxAmount            Decimal               @default(0)
  lineTotal            Decimal
  remarks              String?
  goodsReceiptLines    GoodsReceiptLine[]
  product              Product?              @relation(fields: [productId], references: [id])
  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierInvoiceLines SupplierInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model SupplierInvoice {
  id                         String                      @id @default(uuid())
  companyId                  String
  invoiceNumber              String
  supplierId                 String
  purchaseOrderId            String?
  goodsReceiptNoteId         String?
  invoiceDate                DateTime
  dueDate                    DateTime?
  currency                   String                      @default("USD")
  subtotal                   Decimal                     @default(0)
  discountAmount             Decimal                     @default(0)
  taxAmount                  Decimal                     @default(0)
  shippingAmount             Decimal                     @default(0)
  totalAmount                Decimal                     @default(0)
  status                     SupplierInvoiceStatus       @default(DRAFT)
  remarks                    String?
  approvedById               String?
  approvedAt                 DateTime?
  createdById                String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  approvedBy                 User?                       @relation("SupplierInvoiceApprover", fields: [approvedById], references: [id])
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy                  User?                       @relation("SupplierInvoiceCreator", fields: [createdById], references: [id])
  goodsReceiptNote           GoodsReceiptNote?           @relation(fields: [goodsReceiptNoteId], references: [id])
  purchaseOrder              PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  supplier                   Supplier                    @relation(fields: [supplierId], references: [id])
  lines                      SupplierInvoiceLine[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  threeWayMatches            ThreeWayMatch[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptNoteId])
  @@index([status])
}

model SupplierInvoiceLine {
  id                  String             @id @default(uuid())
  supplierInvoiceId   String
  purchaseOrderLineId String?
  goodsReceiptLineId  String?
  productId           String?
  quantity            Decimal
  unitPrice           Decimal
  discountAmount      Decimal            @default(0)
  taxAmount           Decimal            @default(0)
  lineTotal           Decimal
  goodsReceiptLine    GoodsReceiptLine?  @relation(fields: [goodsReceiptLineId], references: [id])
  product             Product?           @relation(fields: [productId], references: [id])
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  supplierInvoice     SupplierInvoice    @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  @@index([supplierInvoiceId])
  @@index([purchaseOrderLineId])
  @@index([goodsReceiptLineId])
  @@index([productId])
}

model ThreeWayMatch {
  id                 String              @id @default(uuid())
  companyId          String
  purchaseOrderId    String
  goodsReceiptNoteId String
  supplierInvoiceId  String
  matchStatus        ThreeWayMatchStatus @default(PENDING_REVIEW)
  quantityMatched    Boolean             @default(false)
  priceMatched       Boolean             @default(false)
  varianceAmount     Decimal             @default(0)
  remarks            String?
  createdAt          DateTime            @default(now())
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goodsReceiptNote   GoodsReceiptNote    @relation(fields: [goodsReceiptNoteId], references: [id])
  purchaseOrder      PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  supplierInvoice    SupplierInvoice     @relation(fields: [supplierInvoiceId], references: [id])

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptNoteId])
  @@index([supplierInvoiceId])
  @@index([matchStatus])
}

model SupplierPayment {
  id                String                      @id @default(uuid())
  companyId         String
  paymentNumber     String
  supplierId        String
  paymentDate       DateTime
  paymentMethod     PaymentMethod               @default(BANK)
  referenceNumber   String?
  bankAccountId     String?
  currency          String                      @default("USD")
  amount            Decimal                     @default(0)
  allocatedAmount   Decimal                     @default(0)
  unallocatedAmount Decimal                     @default(0)
  status            SupplierPaymentStatus       @default(DRAFT)
  remarks           String?
  createdById       String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy         User?                       @relation("SupplierPaymentCreator", fields: [createdById], references: [id])
  supplier          Supplier                    @relation(fields: [supplierId], references: [id])
  allocations       SupplierPaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@index([supplierId])
  @@index([status])
}

model SupplierPaymentAllocation {
  id                String          @id @default(uuid())
  supplierPaymentId String
  supplierInvoiceId String
  allocatedAmount   Decimal
  createdAt         DateTime        @default(now())
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)

  @@index([supplierPaymentId])
  @@index([supplierInvoiceId])
}

model StockTransaction {
  id              String         @id @default(uuid())
  companyId       String
  warehouseId     String
  productId       String
  type            String
  quantity        Int
  reference       String?
  purchaseOrderId String?
  notes           String?
  createdAt       DateTime       @default(now())
  performedById   String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  performedBy     User           @relation(fields: [performedById], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
}

model AssetCategory {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assets       Asset[]
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  systemSource String   @default("LEGACY")

  @@unique([companyId, name])
  @@index([companyId])
}

model Asset {
  id               String        @id @default(uuid())
  companyId        String
  assetCode        String
  name             String
  categoryId       String
  purchaseDate     DateTime?
  purchasePrice    Decimal       @default(0)
  warrantyExpDate  DateTime?
  serialNumber     String?
  currentLocation  String?
  depreciationRate Decimal       @default(0)
  status           String        @default("ACTIVE")
  assignedToId     String?

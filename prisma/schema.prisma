  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id])
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

model EmployeeLoanInstallment {
  id               String       @id @default(uuid())
  loanId           String
  installmentNo    Int
  dueDate          DateTime
  amount           Decimal
  isRecovered      Boolean      @default(false)
  recoveryDate     DateTime?
  payrollReference String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  loan             EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

model SalaryAdvance {
  id             String                  @id @default(uuid())
  companyId      String
  employeeId     String
  advanceNumber  String                  @unique
  amount         Decimal
  issueDate      DateTime                @default(now())
  recoveryMethod String                  @default("PAYROLL")
  status         String                  @default("DRAFT")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee                @relation(fields: [employeeId], references: [id])
  recoveries     SalaryAdvanceRecovery[]

  @@index([companyId])
  @@index([employeeId])
}

model SalaryAdvanceRecovery {
  id               String        @id @default(uuid())
  advanceId        String
  amount           Decimal
  recoveryDate     DateTime      @default(now())
  payrollReference String?
  createdAt        DateTime      @default(now())
  advance          SalaryAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([advanceId])
}

model PerformanceCycle {
  id               String                       @id @default(uuid())
  companyId        String
  name             String
  startDate        DateTime
  endDate          DateTime
  status           String                       @default("ACTIVE")
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  company          Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goals            PerformanceGoal[]
  improvementPlans PerformanceImprovementPlan[]
  reviews          PerformanceReview[]

  @@index([companyId])
}

model PerformanceGoal {
  id         String           @id @default(uuid())
  employeeId String
  cycleId    String
  goal       String
  weight     Decimal
  target     String?
  status     String           @default("ACTIVE")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([cycleId])
}

model PerformanceReview {
  id            String                @id @default(uuid())
  employeeId    String
  reviewerId    String
  cycleId       String
  reviewDate    DateTime              @default(now())
  overallRating Decimal?
  comments      String?
  status        String                @default("DRAFT")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  feedbacks     PerformanceFeedback[]
  cycle         PerformanceCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee      Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer      Employee              @relation("Reviewer", fields: [reviewerId], references: [id])
  scores        PerformanceScore[]

  @@index([employeeId])
  @@index([reviewerId])
  @@index([cycleId])
}

model PerformanceScore {
  id        String            @id @default(uuid())
  reviewId  String
  category  String
  score     Decimal
  comments  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  review    PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model PerformanceFeedback {
  id        String            @id @default(uuid())
  reviewId  String
  authorId  String
  type      String
  feedback  String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  author    Employee          @relation("FeedbackAuthor", fields: [authorId], references: [id])
  review    PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([authorId])
}

model PerformanceImprovementPlan {
  id         String           @id @default(uuid())
  employeeId String
  cycleId    String
  objectives String
  actions    String
  targetDate DateTime
  progress   String?
  status     String           @default("ACTIVE")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([cycleId])
}

model TrainingProgram {
  id            String            @id @default(uuid())
  companyId     String
  code          String
  title         String
  description   String?
  category      String
  durationHours Decimal?
  status        String            @default("ACTIVE")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions      TrainingSession[]

  @@index([companyId])
}

model TrainingSession {
  id            String               @id @default(uuid())
  programId     String
  trainerId     String?
  location      String?
  onlineLink    String?
  scheduleStart DateTime
  scheduleEnd   DateTime
  capacity      Int?
  status        String               @default("SCHEDULED")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  enrollments   TrainingEnrollment[]
  program       TrainingProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  trainer       Employee?            @relation("Trainer", fields: [trainerId], references: [id])

  @@index([programId])
  @@index([trainerId])
}

model TrainingEnrollment {
  id             String                @id @default(uuid())
  sessionId      String
  employeeId     String
  enrollmentDate DateTime              @default(now())
  status         String                @default("ENROLLED")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  assessments    TrainingAssessment[]
  attendances    TrainingAttendance[]
  certificates   TrainingCertificate[]
  employee       Employee              @relation("Trainee", fields: [employeeId], references: [id], onDelete: Cascade)
  session        TrainingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([employeeId])
}

model TrainingAttendance {
  id           String             @id @default(uuid())
  enrollmentId String
  status       String
  remarks      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  enrollment   TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model TrainingAssessment {
  id           String             @id @default(uuid())
  enrollmentId String
  evaluatorId  String?
  score        Decimal?
  result       String
  remarks      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  enrollment   TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  evaluator    Employee?          @relation("Assessor", fields: [evaluatorId], references: [id])

  @@index([enrollmentId])
  @@index([evaluatorId])
}

model TrainingCertificate {
  id                String             @id @default(uuid())
  enrollmentId      String
  certificateNumber String             @unique
  issueDate         DateTime           @default(now())
  expiryDate        DateTime?
  documentUrl       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  enrollment        TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}


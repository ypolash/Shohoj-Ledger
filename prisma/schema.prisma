  createdById String
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ApiKeyCreator", fields: [createdById], references: [id])

  @@index([companyId])

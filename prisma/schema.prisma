  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  performedBy   User     @relation(fields: [performedById], references: [id])

  @@index([companyId])
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  companyId String

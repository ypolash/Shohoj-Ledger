  description   String?
  moduleKey     String
  dataSource    String
  configuration Json
  isActive      Boolean            @default(true)
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  executions    ReportExecution[]
